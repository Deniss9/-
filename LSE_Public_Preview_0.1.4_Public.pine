//@version=6
indicator(
     title = "Logic Stack Entry 2.0 Public Preview 0.1.4",
     shorttitle = "LSE 2.0 Preview 0.1.4",
     overlay = true,
     format = format.price,
     max_labels_count = 500,
     max_lines_count = 300
)

//=============================================================================
// Logic Stack Entry 2.0 Public Preview 0.1.4
//
// 产品定位：
// - 交易辅助指标，不是已验证交易策略。
// - 转折确认只表示枢轴结构已经确认，不代表必然反转。
// - 静态计划可定义只表示参考入场、结构止损和结构目标能够被描述。
// - 不公开统一总分，不承诺胜率、收益率或稳定盈利。
// - 后续Verified Module继续在Master Backtest中独立研究。
//=============================================================================

//-----------------------------------------------------------------------------
// 参数分组
//-----------------------------------------------------------------------------
string GRP_MODE    = "00. Public Preview"
string GRP_VALUE   = "01. 成本与价值位置｜仅自定义模式可改"
string GRP_CHANNEL = "02. 大级别通道"
string GRP_LEVELS  = "03. 支撑 / 压力"
string GRP_PATTERN = "04. K线与成交量"
string GRP_MOM     = "05. 动能与背离"
string GRP_SIGNAL  = "06. 转折信号"
string GRP_RISK    = "07. 计划检查与静态参考"
string GRP_DISPLAY = "08. 图表与面板"
string GRP_ALERT   = "09. 警报与说明"

//=============================================================================
// 00. Public Preview设置
//=============================================================================
chartDisplayMode = input.string(
     "标准｜VWAP + SD±1价值区",
     "一键视图预设",
     options = [
         "极简｜仅通道、信号和面板",
         "标准｜VWAP + SD±1价值区",
         "完整｜显示全部成本与价值线",
         "自定义｜使用下方独立开关"
     ],
     tooltip = "预设会直接接管成本与价值线显示。只有选择“自定义”时，下方逐项开关才可修改。此设置只改变图表显示，不改变信号、风险或警报。",
     group = GRP_MODE)

bool customDisplayControlsActive =
     chartDisplayMode == "自定义｜使用下方独立开关"

signalSensitivity = input.string(
     "标准",
     "转折信号灵敏度",
     options = ["标准", "严格"],
     tooltip = "标准信号更多；严格模式要求更远的枢轴偏离并增加间隔。",
     group = GRP_MODE)

panelDisplayMode = input.string(
     "简洁",
     "面板显示",
     options = ["简洁", "详细"],
     tooltip = "简洁面板面向日常使用；详细面板显示风险原因和技术证据。",
     group = GRP_MODE)

showStaticPlanLines = input.bool(
     false,
     "显示静态计划参考线",
     tooltip = "显示最近一次完整转折冻结的参考入场、结构止损和结构目标。止损距离与RR只做提示，不代表信号更准确。",
     group = GRP_MODE)

showObserveSignalsInput = input.bool(
     true,
     "显示早期观察",
     tooltip = "早期观察发生在真实确认K线上，不回填到枢轴位置。",
     group = GRP_MODE)

showTurnSignalsInput = input.bool(
     true,
     "显示完整转折确认",
     tooltip = "完整转折只表示枢轴结构确认，不代表必然反转。",
     group = GRP_MODE)

string PUBLIC_SPEC = "PUBLIC-PREVIEW-0.1.4-SPEC-V4.3"
string PUBLIC_SPEC_SHA = "943F4E363A9E37336EB53C11783EF462E33611A2A946CE157F82300DCDD8F49D"

//=============================================================================
// 通用函数
//=============================================================================
f_enabledLevel(float levelValue) =>
    not na(levelValue) and levelValue > 0

f_nearLevel(float priceValue, float levelValue, float toleranceValue) =>
    f_enabledLevel(levelValue) and math.abs(priceValue - levelValue) <= toleranceValue

f_bullSweep(float levelValue) =>
    f_enabledLevel(levelValue) and low < levelValue and close > levelValue

f_bearSweep(float levelValue) =>
    f_enabledLevel(levelValue) and high > levelValue and close < levelValue

f_brokenBelow(float levelValue) =>
    f_enabledLevel(levelValue) and close < levelValue and close[1] < levelValue

f_brokenAbove(float levelValue) =>
    f_enabledLevel(levelValue) and close > levelValue and close[1] > levelValue

f_bullStreak(int barsCount) =>
    ta.barssince(close <= open) >= barsCount

f_bearStreak(int barsCount) =>
    ta.barssince(close >= open) >= barsCount

f_recent(bool eventValue, int validBars) =>
    int barsSinceEvent = ta.barssince(eventValue)
    not na(barsSinceEvent) and barsSinceEvent <= validBars

f_addReason(string baseText, bool conditionValue, string reasonText) =>
    conditionValue ? (baseText == "" ? reasonText : baseText + "、" + reasonText) : baseText

f_fmt(float value) =>
    na(value) ? "N/A" : str.tostring(value, format.mintick)

f_fmtRR(float value) =>
    na(value) ? "N/A" : str.tostring(value, "#.##")

f_nearestAbove12(
     float entryValue,
     float minDistance,
     float a,
     float b,
     float c,
     float d,
     float e,
     float f,
     float g,
     float h,
     float i,
     float j,
     float k,
     float l) =>
    float bestValue = na
    float minimumValue = entryValue + minDistance
    if f_enabledLevel(a) and a >= minimumValue
        bestValue := a
    if f_enabledLevel(b) and b >= minimumValue and (na(bestValue) or b < bestValue)
        bestValue := b
    if f_enabledLevel(c) and c >= minimumValue and (na(bestValue) or c < bestValue)
        bestValue := c
    if f_enabledLevel(d) and d >= minimumValue and (na(bestValue) or d < bestValue)
        bestValue := d
    if f_enabledLevel(e) and e >= minimumValue and (na(bestValue) or e < bestValue)
        bestValue := e
    if f_enabledLevel(f) and f >= minimumValue and (na(bestValue) or f < bestValue)
        bestValue := f
    if f_enabledLevel(g) and g >= minimumValue and (na(bestValue) or g < bestValue)
        bestValue := g
    if f_enabledLevel(h) and h >= minimumValue and (na(bestValue) or h < bestValue)
        bestValue := h
    if f_enabledLevel(i) and i >= minimumValue and (na(bestValue) or i < bestValue)
        bestValue := i
    if f_enabledLevel(j) and j >= minimumValue and (na(bestValue) or j < bestValue)
        bestValue := j
    if f_enabledLevel(k) and k >= minimumValue and (na(bestValue) or k < bestValue)
        bestValue := k
    if f_enabledLevel(l) and l >= minimumValue and (na(bestValue) or l < bestValue)
        bestValue := l
    bestValue

f_nearestBelow12(
     float entryValue,
     float minDistance,
     float a,
     float b,
     float c,
     float d,
     float e,
     float f,
     float g,
     float h,
     float i,
     float j,
     float k,
     float l) =>
    float bestValue = na
    float maximumValue = entryValue - minDistance
    if f_enabledLevel(a) and a <= maximumValue
        bestValue := a
    if f_enabledLevel(b) and b <= maximumValue and (na(bestValue) or b > bestValue)
        bestValue := b
    if f_enabledLevel(c) and c <= maximumValue and (na(bestValue) or c > bestValue)
        bestValue := c
    if f_enabledLevel(d) and d <= maximumValue and (na(bestValue) or d > bestValue)
        bestValue := d
    if f_enabledLevel(e) and e <= maximumValue and (na(bestValue) or e > bestValue)
        bestValue := e
    if f_enabledLevel(f) and f <= maximumValue and (na(bestValue) or f > bestValue)
        bestValue := f
    if f_enabledLevel(g) and g <= maximumValue and (na(bestValue) or g > bestValue)
        bestValue := g
    if f_enabledLevel(h) and h <= maximumValue and (na(bestValue) or h > bestValue)
        bestValue := h
    if f_enabledLevel(i) and i <= maximumValue and (na(bestValue) or i > bestValue)
        bestValue := i
    if f_enabledLevel(j) and j <= maximumValue and (na(bestValue) or j > bestValue)
        bestValue := j
    if f_enabledLevel(k) and k <= maximumValue and (na(bestValue) or k > bestValue)
        bestValue := k
    if f_enabledLevel(l) and l <= maximumValue and (na(bestValue) or l > bestValue)
        bestValue := l
    bestValue

f_closestBelow3(float entryValue, float a, float b, float c) =>
    float bestValue = na
    if not na(a) and a < entryValue
        bestValue := a
    if not na(b) and b < entryValue and (na(bestValue) or b > bestValue)
        bestValue := b
    if not na(c) and c < entryValue and (na(bestValue) or c > bestValue)
        bestValue := c
    bestValue

f_closestAbove3(float entryValue, float a, float b, float c) =>
    float bestValue = na
    if not na(a) and a > entryValue
        bestValue := a
    if not na(b) and b > entryValue and (na(bestValue) or b < bestValue)
        bestValue := b
    if not na(c) and c > entryValue and (na(bestValue) or c < bestValue)
        bestValue := c
    bestValue

f_farthestBelow3(float entryValue, float a, float b, float c) =>
    float bestValue = na
    if not na(a) and a < entryValue
        bestValue := a
    if not na(b) and b < entryValue and (na(bestValue) or b < bestValue)
        bestValue := b
    if not na(c) and c < entryValue and (na(bestValue) or c < bestValue)
        bestValue := c
    bestValue

f_farthestAbove3(float entryValue, float a, float b, float c) =>
    float bestValue = na
    if not na(a) and a > entryValue
        bestValue := a
    if not na(b) and b > entryValue and (na(bestValue) or b > bestValue)
        bestValue := b
    if not na(c) and c > entryValue and (na(bestValue) or c > bestValue)
        bestValue := c
    bestValue

f_updateRightLabel(
     label oldLabel,
     float yValue,
     string labelText,
     color labelColor,
     bool enabled,
     int xOffset) =>
    label resultLabel = oldLabel
    if barstate.islast
        if enabled and not na(yValue)
            if na(resultLabel)
                resultLabel := label.new(
                     x = bar_index + xOffset,
                     y = yValue,
                     text = labelText,
                     xloc = xloc.bar_index,
                     yloc = yloc.price,
                     style = label.style_none,
                     textcolor = labelColor,
                     size = size.small)
            else
                label.set_xy(resultLabel, bar_index + xOffset, yValue)
                label.set_text(resultLabel, labelText)
                label.set_textcolor(resultLabel, labelColor)
        else if not na(resultLabel)
            label.delete(resultLabel)
            resultLabel := na
    resultLabel

//=============================================================================
// 01. ValueMap 趋势与价格位置
//=============================================================================
valueSource = input.source(hlc3, "价格源", group = GRP_VALUE)

valuePeriodChoice = input.string(
     "自动",
     "成本与价格区间周期",
     options = ["自动", "日", "周", "月"],
     tooltip = "推荐使用自动：1小时及以下看日，4小时看周，日线看月。",
     group = GRP_VALUE)

float sdMultiplier1 = 1.0
float sdMultiplier2 = 2.0

showCurrentCenterInput = input.bool(
     true,
     "自定义：显示当前周期VWAP",
     group = GRP_VALUE,
     active = customDisplayControlsActive)

showHigherVwapInput = input.bool(
     true,
     "自定义：显示更大周期VWAP",
     group = GRP_VALUE,
     active = customDisplayControlsActive)

showSd1Input = input.bool(
     true,
     "自定义：显示当前SD±1边界线",
     group = GRP_VALUE,
     active = customDisplayControlsActive)

showSd2Input = input.bool(
     true,
     "自定义：显示当前SD±2",
     group = GRP_VALUE,
     active = customDisplayControlsActive)

showPvwInput = input.bool(
     true,
     "自定义：显示上一周期pVWAP",
     group = GRP_VALUE,
     active = customDisplayControlsActive)

showPsd1Input = input.bool(
     true,
     "自定义：显示上一周期pSD±1",
     group = GRP_VALUE,
     active = customDisplayControlsActive)

fillSd1Input = input.bool(
     true,
     "自定义：填充当前SD±1价值区",
     group = GRP_VALUE,
     active = customDisplayControlsActive)

color currentVwapColorInput = color.rgb(238, 238, 238)
color higherVwapColorInput = color.rgb(229, 183, 20)
color sd1ColorInput = color.rgb(130, 135, 145)
color sd2UpColorInput = color.rgb(160, 100, 100)
color sd2DownColorInput = color.rgb(70, 105, 185)
color pVwapColorInput = color.rgb(45, 190, 210)
color pSdColorInput = color.rgb(80, 155, 170)

newDay = timeframe.change("D")
newWeek = timeframe.change("W")
newMonth = timeframe.change("M")
newQuarter = timeframe.change("3M")
newYear = timeframe.change("12M")

dailyVwap = ta.vwap(valueSource, newDay)
weeklyVwap = ta.vwap(valueSource, newWeek)
monthlyVwap = ta.vwap(valueSource, newMonth)
quarterlyVwap = ta.vwap(valueSource, newQuarter)
yearlyVwap = ta.vwap(valueSource, newYear)

string resolvedValuePeriod = valuePeriodChoice

if valuePeriodChoice == "自动"
    if timeframe.isintraday
        if timeframe.in_seconds(timeframe.period) <= 3600
            resolvedValuePeriod := "日"
        else
            resolvedValuePeriod := "周"
    else if timeframe.isdaily
        resolvedValuePeriod := "月"
    else if timeframe.isweekly
        resolvedValuePeriod := "季度"
    else
        resolvedValuePeriod := "年度"

bool newValuePeriod = newWeek

if resolvedValuePeriod == "日"
    newValuePeriod := newDay
else if resolvedValuePeriod == "周"
    newValuePeriod := newWeek
else if resolvedValuePeriod == "月"
    newValuePeriod := newMonth
else if resolvedValuePeriod == "季度"
    newValuePeriod := newQuarter
else
    newValuePeriod := newYear

[currentCenter1, currentUpper1, currentLower1] =
     ta.vwap(valueSource, newValuePeriod, sdMultiplier1)

[currentCenter2, currentUpper2, currentLower2] =
     ta.vwap(valueSource, newValuePeriod, sdMultiplier2)

currentValueCenter = currentCenter1

float higherTrendVwap = weeklyVwap
string currentPeriodText = "本周"
string previousPeriodText = "上周"
string higherTrendName = "月VWAP"

if resolvedValuePeriod == "日"
    higherTrendVwap := weeklyVwap
    currentPeriodText := "本日"
    previousPeriodText := "上一日"
    higherTrendName := "周VWAP"
else if resolvedValuePeriod == "周"
    higherTrendVwap := monthlyVwap
    currentPeriodText := "本周"
    previousPeriodText := "上周"
    higherTrendName := "月VWAP"
else if resolvedValuePeriod == "月"
    higherTrendVwap := quarterlyVwap
    currentPeriodText := "本月"
    previousPeriodText := "上月"
    higherTrendName := "季度VWAP"
else if resolvedValuePeriod == "季度"
    higherTrendVwap := yearlyVwap
    currentPeriodText := "本季度"
    previousPeriodText := "上一季度"
    higherTrendName := "年度VWAP"
else
    higherTrendVwap := yearlyVwap
    currentPeriodText := "本年度"
    previousPeriodText := "上一年度"
    higherTrendName := "年度VWAP"

var float previousVwap = na
var float previousUpper1 = na
var float previousLower1 = na
var float previousUpper2 = na
var float previousLower2 = na

if newValuePeriod and not barstate.isfirst
    previousVwap := currentCenter1[1]
    previousUpper1 := currentUpper1[1]
    previousLower1 := currentLower1[1]
    previousUpper2 := currentUpper2[1]
    previousLower2 := currentLower2[1]

bool minimalChartDisplay =
     chartDisplayMode == "极简｜仅通道、信号和面板"

bool standardChartDisplay =
     chartDisplayMode == "标准｜VWAP + SD±1价值区"

bool fullChartDisplay =
     chartDisplayMode == "完整｜显示全部成本与价值线"

bool customChartDisplay =
     chartDisplayMode == "自定义｜使用下方独立开关"

// 视图预设只控制显示，不参与任何信号、风险、目标或警报计算。
// 极简：隐藏全部成本与价值线；标准：当前VWAP + 更大周期VWAP + SD±1价值区填充；完整：全部线组。
bool showCurrentCenter = customChartDisplay ? showCurrentCenterInput : (standardChartDisplay or fullChartDisplay)
bool showHigherVwap = customChartDisplay ? showHigherVwapInput : (standardChartDisplay or fullChartDisplay)
bool showSd1 = customChartDisplay ? showSd1Input : fullChartDisplay
bool showSd2 = customChartDisplay ? showSd2Input : fullChartDisplay
bool showPvw = customChartDisplay ? showPvwInput : fullChartDisplay
bool showPsd1 = customChartDisplay ? showPsd1Input : fullChartDisplay
bool fillSd1 = customChartDisplay ? fillSd1Input : (standardChartDisplay or fullChartDisplay)

color currentVwapColor = color.rgb(238, 238, 238)
color higherVwapColor = color.rgb(229, 183, 20)
color sd1Color = color.rgb(130, 135, 145)
color sd2UpColor = color.rgb(160, 100, 100)
color sd2DownColor = color.rgb(70, 105, 185)
color pVwapColor = color.rgb(45, 190, 210)
color pSdColor = color.rgb(80, 155, 170)

currentCenterPlot = plot(
     showCurrentCenter ? currentValueCenter : na,
     "当前周期VWAP",
     color = currentVwapColor,
     linewidth = 3,
     style = plot.style_linebr,
     display = display.all - display.status_line)

higherVwapPlot = plot(
     showHigherVwap ? higherTrendVwap : na,
     "更大周期VWAP",
     color = higherVwapColor,
     linewidth = 2,
     style = plot.style_linebr,
     display = display.all - display.status_line)

currentUpper1Plot = plot(
     showSd1 or fillSd1 ? currentUpper1 : na,
     "当前SD+1",
     color = showSd1 ? sd1Color : color.new(color.white, 100),
     linewidth = 1,
     style = plot.style_linebr,
     display = display.all - display.status_line)

currentLower1Plot = plot(
     showSd1 or fillSd1 ? currentLower1 : na,
     "当前SD-1",
     color = showSd1 ? sd1Color : color.new(color.white, 100),
     linewidth = 1,
     style = plot.style_linebr,
     display = display.all - display.status_line)

plot(
     showSd2 ? currentUpper2 : na,
     "当前SD+2",
     color = sd2UpColor,
     linewidth = 2,
     style = plot.style_linebr,
     display = display.all - display.status_line)

plot(
     showSd2 ? currentLower2 : na,
     "当前SD-2",
     color = sd2DownColor,
     linewidth = 2,
     style = plot.style_linebr,
     display = display.all - display.status_line)

fill(
     currentUpper1Plot,
     currentLower1Plot,
     color = fillSd1 ? color.new(color.gray, 89) : na,
     title = "当前SD±1价值区")

// 上一周期水平只保留当前正在使用的一组，并以虚线/点线区分。
var line activePvwLine = na
var line activePsdUpperLine = na
var line activePsdLowerLine = na

if newValuePeriod and not barstate.isfirst
    if not na(activePvwLine)
        line.delete(activePvwLine)
    if not na(activePsdUpperLine)
        line.delete(activePsdUpperLine)
    if not na(activePsdLowerLine)
        line.delete(activePsdLowerLine)

    activePvwLine := na
    activePsdUpperLine := na
    activePsdLowerLine := na

    if showPvw and not na(previousVwap)
        activePvwLine := line.new(
             x1 = bar_index,
             y1 = previousVwap,
             x2 = bar_index + 1,
             y2 = previousVwap,
             xloc = xloc.bar_index,
             extend = extend.right,
             color = pVwapColor,
             style = line.style_dashed,
             width = 2)

    if showPsd1 and not na(previousUpper1) and not na(previousLower1)
        activePsdUpperLine := line.new(
             x1 = bar_index,
             y1 = previousUpper1,
             x2 = bar_index + 1,
             y2 = previousUpper1,
             xloc = xloc.bar_index,
             extend = extend.right,
             color = pSdColor,
             style = line.style_dotted,
             width = 1)

        activePsdLowerLine := line.new(
             x1 = bar_index,
             y1 = previousLower1,
             x2 = bar_index + 1,
             y2 = previousLower1,
             xloc = xloc.bar_index,
             extend = extend.right,
             color = pSdColor,
             style = line.style_dotted,
             width = 1)


//=============================================================================
// 02. 大级别通道（lookahead_off + 已确认高周期冻结）
//=============================================================================
channelMode = input.string(
     "自动+手动",
     "结构模式",
     options = ["自动", "手动", "自动+手动"],
     tooltip = "自动通道与手动结构位可以单独或同时使用。",
     group = GRP_CHANNEL)

channelTimeframe = input.timeframe("240", "通道周期", group = GRP_CHANNEL)
channelLookback = input.int(100, "回归回看长度", minval = 20, maxval = 500, group = GRP_CHANNEL)
channelDeviation = input.float(2.0, "通道标准差倍数", minval = 0.5, maxval = 5.0, step = 0.1, group = GRP_CHANNEL)
channelNearAtr = input.float(0.35, "靠近通道ATR倍数", minval = 0.05, maxval = 3.0, step = 0.05, group = GRP_CHANNEL)
showRegressionChannel = input.bool(true, "显示完整回归通道", group = GRP_CHANNEL)

bool useAutoChannel = channelMode == "自动" or channelMode == "自动+手动"
bool useManualLevels = channelMode == "手动" or channelMode == "自动+手动"

[channelBasisRequested, channelDevRequested, channelSlopeRequested] =
     request.security(
         syminfo.tickerid,
         channelTimeframe,
         [
             ta.linreg(close, channelLookback, 0),
             ta.stdev(close - ta.linreg(close, channelLookback, 0), channelLookback),
             ta.linreg(close, channelLookback, 0) - ta.linreg(close, channelLookback, 1)
         ],
         gaps = barmerge.gaps_off,
         lookahead = barmerge.lookahead_off)

bool newChannelPeriod = timeframe.change(channelTimeframe)

var float confirmedChannelBasis = na
var float confirmedChannelDev = na
var float confirmedChannelSlope = na

if newChannelPeriod and not barstate.isfirst
    confirmedChannelBasis := channelBasisRequested[1]
    confirmedChannelDev := channelDevRequested[1]
    confirmedChannelSlope := channelSlopeRequested[1]
else if na(confirmedChannelBasis) and not na(channelBasisRequested[1])
    confirmedChannelBasis := channelBasisRequested[1]
    confirmedChannelDev := channelDevRequested[1]
    confirmedChannelSlope := channelSlopeRequested[1]

float channelMid = useAutoChannel ? confirmedChannelBasis : na
float channelUpper = useAutoChannel ? confirmedChannelBasis + confirmedChannelDev * channelDeviation : na
float channelLower = useAutoChannel ? confirmedChannelBasis - confirmedChannelDev * channelDeviation : na
bool channelReady = useAutoChannel and not na(channelUpper) and not na(channelLower)

color channelColor = color.rgb(70, 130, 220)
channelUpperPlot = plot(showRegressionChannel and channelReady ? channelUpper : na, "通道上轨", color = color.new(channelColor, 5), linewidth = 2, display = display.all - display.status_line)
channelMidPlot = plot(showRegressionChannel and channelReady ? channelMid : na, "通道中轨", color = color.new(color.gray, 25), linewidth = 1, display = display.all - display.status_line)
channelLowerPlot = plot(showRegressionChannel and channelReady ? channelLower : na, "通道下轨", color = color.new(channelColor, 5), linewidth = 2, display = display.all - display.status_line)
fill(channelUpperPlot, channelLowerPlot, color = showRegressionChannel ? color.new(channelColor, 93) : na, title = "回归通道填充")


//=============================================================================
// 03. 支撑 / 压力
//=============================================================================
support1 = input.float(0.0, "支撑1（0=关闭）", minval = 0.0, group = GRP_LEVELS)
support2 = input.float(0.0, "支撑2", minval = 0.0, group = GRP_LEVELS)
support3 = input.float(0.0, "支撑3", minval = 0.0, group = GRP_LEVELS)
resistance1 = input.float(0.0, "压力1（0=关闭）", minval = 0.0, group = GRP_LEVELS)
resistance2 = input.float(0.0, "压力2", minval = 0.0, group = GRP_LEVELS)
resistance3 = input.float(0.0, "压力3", minval = 0.0, group = GRP_LEVELS)

referenceLookback = input.int(50, "前高/前低回看", minval = 5, maxval = 500, group = GRP_LEVELS)
roundStep = input.float(100.0, "整数位间距", minval = 0.00000001, group = GRP_LEVELS)
zoneAtrTolerance = input.float(0.30, "结构位容差ATR倍数", minval = 0.05, maxval = 3.0, step = 0.05, group = GRP_LEVELS)
zonePctTolerance = input.float(0.15, "结构位容差价格百分比", minval = 0.01, maxval = 5.0, step = 0.01, group = GRP_LEVELS)
showManualLevelsInput = input.bool(true, "显示手动支撑/压力", group = GRP_LEVELS)

int effectiveReferenceLookback = referenceLookback
float effectiveRoundStep = roundStep
float effectiveZoneAtrTolerance = zoneAtrTolerance
float effectiveZonePctTolerance = zonePctTolerance

//=============================================================================
// 04. K线与成交量
//=============================================================================
wickBodyRatio = input.float(1.8, "长影线/实体最小倍数", minval = 0.5, maxval = 10.0, step = 0.1, group = GRP_PATTERN)
wickRangePct = input.float(0.45, "影线占整根K线最小比例", minval = 0.10, maxval = 0.90, step = 0.05, group = GRP_PATTERN)
confirmBars = input.int(2, "当前周期连续阳线/阴线根数", minval = 2, maxval = 5, group = GRP_PATTERN)
keyEmaLength = input.int(20, "短线关键位EMA", minval = 2, maxval = 200, group = GRP_PATTERN)
volumeLength = input.int(20, "成交量均线长度", minval = 2, maxval = 200, group = GRP_PATTERN)
volumeMultiplier = input.float(1.5, "放量倍数", minval = 1.0, maxval = 10.0, step = 0.1, group = GRP_PATTERN)
noBreakLookback = input.int(5, "放量不破高低回看", minval = 2, maxval = 50, group = GRP_PATTERN)

//=============================================================================
// 05. 动能与背离
//=============================================================================
rsiLength = input.int(14, "RSI长度", minval = 2, maxval = 100, group = GRP_MOM)
ppoFast = input.int(12, "PPO快线", minval = 2, maxval = 100, group = GRP_MOM)
ppoSlow = input.int(26, "PPO慢线", minval = 3, maxval = 200, group = GRP_MOM)
ppoSignal = input.int(9, "PPO信号线", minval = 2, maxval = 100, group = GRP_MOM)
divPivotLeft = input.int(5, "背离枢轴左侧", minval = 1, maxval = 20, group = GRP_MOM)
divPivotRight = input.int(5, "背离枢轴右侧", minval = 1, maxval = 20, group = GRP_MOM)
divergenceValidBars = input.int(12, "背离有效K线数", minval = 1, maxval = 100, group = GRP_MOM)
structureValidBars = input.int(10, "结构事件有效K线数", minval = 1, maxval = 100, group = GRP_MOM)
momentumLookback = input.int(2, "PPO动能减弱确认长度", minval = 1, maxval = 10, group = GRP_MOM)
stochLength = input.int(14, "KD周期", minval = 2, maxval = 100, group = GRP_MOM)
stochSmoothK = input.int(3, "K平滑", minval = 1, maxval = 20, group = GRP_MOM)
stochSmoothD = input.int(3, "D平滑", minval = 1, maxval = 20, group = GRP_MOM)
stochOversold = input.float(20.0, "KD超卖线", minval = 0, maxval = 50, step = 1, group = GRP_MOM)
stochOverbought = input.float(80.0, "KD超买线", minval = 50, maxval = 100, step = 1, group = GRP_MOM)

//=============================================================================
// 07. 风险与静态计划
//=============================================================================
rrLowWarningThreshold = input.float(
     1.50,
     "RR偏低提示阈值",
     minval = 0.5,
     maxval = 5.0,
     step = 0.1,
     tooltip = "只用于提示RR偏低，不再作为生成静态计划的硬门槛。",
     group = GRP_RISK)

showPlanExpiryBars = input.int(
     20,
     "计划检查与静态参考展示K线",
     minval = 5,
     maxval = 100,
     group = GRP_RISK)


//=============================================================================
// 基础数据与结构参考
//=============================================================================
atrLength = input.int(14, "ATR长度", minval = 2, maxval = 200, group = GRP_RISK)
float atr = ta.atr(atrLength)
float zoneTolerance = math.max(atr * effectiveZoneAtrTolerance, math.abs(close) * effectiveZonePctTolerance / 100.0)
float channelTolerance = atr * channelNearAtr
float keyLevel = ta.ema(close, keyEmaLength)
float volumeAverage = ta.sma(volume, volumeLength)

float priorLow = ta.lowest(low, effectiveReferenceLookback)[1]
float priorHigh = ta.highest(high, effectiveReferenceLookback)[1]

float gapSupport = ta.valuewhen(low > high[1], high[1], 0)
float gapResistance = ta.valuewhen(high < low[1], low[1], 0)

float roundSupportRaw = math.floor(close / effectiveRoundStep) * effectiveRoundStep
float roundResistanceRaw = math.ceil(close / effectiveRoundStep) * effectiveRoundStep
float roundResistance = roundResistanceRaw <= close + syminfo.mintick * 0.5 ? roundResistanceRaw + effectiveRoundStep : roundResistanceRaw
float roundSupport = roundSupportRaw >= close - syminfo.mintick * 0.5 ? roundSupportRaw - effectiveRoundStep : roundSupportRaw

float candleRange = math.max(high - low, syminfo.mintick)
float candleBody = math.max(math.abs(close - open), syminfo.mintick)
float lowerWick = math.min(open, close) - low
float upperWick = high - math.max(open, close)

bool longLowerWick = lowerWick >= candleBody * wickBodyRatio and lowerWick / candleRange >= wickRangePct
bool shortUpperWick = upperWick >= candleBody * wickBodyRatio and upperWick / candleRange >= wickRangePct

bool bullSequence = f_bullStreak(confirmBars)
bool bearSequence = f_bearStreak(confirmBars)

bool reclaimKey = ta.crossover(close, keyLevel)
bool loseKey = ta.crossunder(close, keyLevel)

bool nearChannelLower = channelReady and math.abs(close - channelLower) <= channelTolerance
bool nearChannelUpper = channelReady and math.abs(close - channelUpper) <= channelTolerance
bool nearChannelMid = channelReady and math.abs(close - channelMid) <= channelTolerance

bool nearManualSupport = useManualLevels and (f_nearLevel(close, support1, zoneTolerance) or f_nearLevel(close, support2, zoneTolerance) or f_nearLevel(close, support3, zoneTolerance))
bool nearManualResistance = useManualLevels and (f_nearLevel(close, resistance1, zoneTolerance) or f_nearLevel(close, resistance2, zoneTolerance) or f_nearLevel(close, resistance3, zoneTolerance))

bool nearAutoSupport = f_nearLevel(close, priorLow, zoneTolerance) or f_nearLevel(close, gapSupport, zoneTolerance) or f_nearLevel(close, roundSupport, zoneTolerance)
bool nearAutoResistance = f_nearLevel(close, priorHigh, zoneTolerance) or f_nearLevel(close, gapResistance, zoneTolerance) or f_nearLevel(close, roundResistance, zoneTolerance)

bool nearSupport = nearManualSupport or nearAutoSupport
bool nearResistance = nearManualResistance or nearAutoResistance

bool sweepChannelLower = channelReady and low < channelLower and close > channelLower
bool sweepChannelUpper = channelReady and high > channelUpper and close < channelUpper

bool sweepSupport = sweepChannelLower or f_bullSweep(priorLow) or f_bullSweep(gapSupport) or f_bullSweep(roundSupport) or (useManualLevels and (f_bullSweep(support1) or f_bullSweep(support2) or f_bullSweep(support3)))
bool sweepResistance = sweepChannelUpper or f_bearSweep(priorHigh) or f_bearSweep(gapResistance) or f_bearSweep(roundResistance) or (useManualLevels and (f_bearSweep(resistance1) or f_bearSweep(resistance2) or f_bearSweep(resistance3)))

float priorNoBreakLow = ta.lowest(low, noBreakLookback)[1]
float priorNoBreakHigh = ta.highest(high, noBreakLookback)[1]
bool volumeExpanded = na(volume) ? false : volume > volumeAverage * volumeMultiplier
bool volumeDownNoLow = close < open and volumeExpanded and low >= priorNoBreakLow
bool volumeUpNoHigh = close > open and volumeExpanded and high <= priorNoBreakHigh

//=============================================================================
// 动能与背离计算
//=============================================================================
float rsiValue = ta.rsi(close, rsiLength)

float ppoFastEma = ta.ema(close, ppoFast)
float ppoSlowEma = ta.ema(close, ppoSlow)
float ppoLine = not na(ppoSlowEma) and ppoSlowEma != 0 ? 100.0 * (ppoFastEma - ppoSlowEma) / ppoSlowEma : 0.0
float ppoSignalLine = ta.ema(ppoLine, ppoSignal)
float ppoHistogram = ppoLine - ppoSignalLine

float pricePivotLow = ta.pivotlow(low, divPivotLeft, divPivotRight)
float pricePivotHigh = ta.pivothigh(high, divPivotLeft, divPivotRight)

float previousPivotLow = ta.valuewhen(not na(pricePivotLow), pricePivotLow, 1)
float previousPivotHigh = ta.valuewhen(not na(pricePivotHigh), pricePivotHigh, 1)
float previousRsiAtLow = ta.valuewhen(not na(pricePivotLow), rsiValue[divPivotRight], 1)
float previousRsiAtHigh = ta.valuewhen(not na(pricePivotHigh), rsiValue[divPivotRight], 1)
float previousPpoAtLow = ta.valuewhen(not na(pricePivotLow), ppoHistogram[divPivotRight], 1)
float previousPpoAtHigh = ta.valuewhen(not na(pricePivotHigh), ppoHistogram[divPivotRight], 1)

bool bullRsiDivEvent = not na(pricePivotLow) and not na(previousPivotLow) and pricePivotLow < previousPivotLow and rsiValue[divPivotRight] > previousRsiAtLow
bool bearRsiDivEvent = not na(pricePivotHigh) and not na(previousPivotHigh) and pricePivotHigh > previousPivotHigh and rsiValue[divPivotRight] < previousRsiAtHigh
bool bullPpoDivEvent = not na(pricePivotLow) and not na(previousPivotLow) and pricePivotLow < previousPivotLow and ppoHistogram[divPivotRight] > previousPpoAtLow
bool bearPpoDivEvent = not na(pricePivotHigh) and not na(previousPivotHigh) and pricePivotHigh > previousPivotHigh and ppoHistogram[divPivotRight] < previousPpoAtHigh

bool bullRsiDiv = f_recent(bullRsiDivEvent, divergenceValidBars)
bool bearRsiDiv = f_recent(bearRsiDivEvent, divergenceValidBars)
bool bullPpoDiv = f_recent(bullPpoDivEvent, divergenceValidBars)
bool bearPpoDiv = f_recent(bearPpoDivEvent, divergenceValidBars)

bool higherLowEvent = not na(pricePivotLow) and not na(previousPivotLow) and pricePivotLow > previousPivotLow
bool lowerHighEvent = not na(pricePivotHigh) and not na(previousPivotHigh) and pricePivotHigh < previousPivotHigh
bool higherLow = f_recent(higherLowEvent, structureValidBars)
bool lowerHigh = f_recent(lowerHighEvent, structureValidBars)

bool bearMomentumWeak = ppoHistogram < 0 and ta.rising(ppoHistogram, momentumLookback)
bool bullMomentumWeak = ppoHistogram > 0 and ta.falling(ppoHistogram, momentumLookback)

float lowestLow = ta.lowest(low, stochLength)
float highestHigh = ta.highest(high, stochLength)
float rawK = highestHigh != lowestLow ? 100.0 * (close - lowestLow) / (highestHigh - lowestLow) : 50.0
float stochK = ta.sma(rawK, stochSmoothK)
float stochD = ta.sma(stochK, stochSmoothD)

bool stochBullCross = ta.crossover(stochK, stochD) and math.min(stochK, stochD) <= stochOversold
bool stochBearCross = ta.crossunder(stochK, stochD) and math.max(stochK, stochD) >= stochOverbought


//=============================================================================
// 06. 早期观察与完整转折确认
//=============================================================================
int signalLeft = signalSensitivity == "严格" ? 3 : 2
int formalSignalRight = signalSensitivity == "严格" ? 3 : 2
float signalAtrDistance = signalSensitivity == "严格" ? 0.80 : 0.60
int signalSpacing = signalSensitivity == "严格" ? 12 : 8
float oppositeSwingAtr = signalSensitivity == "严格" ? 1.80 : 1.30
bool strictSignalNeedsRsi = signalSensitivity == "严格"

int quickSignalRight = 1
float quickSignalAtrDistance = signalAtrDistance * 0.75

float quickPivotHigh = ta.pivothigh(high, signalLeft, quickSignalRight)
float quickPivotLow = ta.pivotlow(low, signalLeft, quickSignalRight)
int quickPivotBar = bar_index - quickSignalRight
float quickPivotAtr = atr[quickSignalRight]
float quickPivotCenter = currentValueCenter[quickSignalRight]

bool quickTopBase =
     not na(quickPivotHigh) and
     not na(quickPivotAtr) and
     not na(quickPivotCenter) and
     quickPivotHigh >= quickPivotCenter + quickPivotAtr * quickSignalAtrDistance

bool quickBottomBase =
     not na(quickPivotLow) and
     not na(quickPivotAtr) and
     not na(quickPivotCenter) and
     quickPivotLow <= quickPivotCenter - quickPivotAtr * quickSignalAtrDistance

var int lastQuickTopBar = na
var int lastQuickBottomBar = na
int quickSpacing = math.max(2, int(math.floor(signalSpacing * 0.60)))

bool quickTopEventRaw =
     quickTopBase and
     barstate.isconfirmed and
     (na(lastQuickTopBar) or quickPivotBar - lastQuickTopBar >= quickSpacing)

bool quickBottomEventRaw =
     quickBottomBase and
     barstate.isconfirmed and
     (na(lastQuickBottomBar) or quickPivotBar - lastQuickBottomBar >= quickSpacing)

bool quickSignalConflict = quickTopEventRaw and quickBottomEventRaw
bool quickTopEvent = quickTopEventRaw and not quickSignalConflict
bool quickBottomEvent = quickBottomEventRaw and not quickSignalConflict

if quickTopEvent
    lastQuickTopBar := quickPivotBar
if quickBottomEvent
    lastQuickBottomBar := quickPivotBar

float formalPivotHigh = ta.pivothigh(high, signalLeft, formalSignalRight)
float formalPivotLow = ta.pivotlow(low, signalLeft, formalSignalRight)
int formalPivotBar = bar_index - formalSignalRight
float formalPivotAtr = atr[formalSignalRight]
float formalPivotCenter = currentValueCenter[formalSignalRight]
float formalPivotRsi = rsiValue[formalSignalRight]

bool formalTopBase =
     not na(formalPivotHigh) and
     not na(formalPivotCenter) and
     not na(formalPivotAtr) and
     formalPivotHigh >= formalPivotCenter + formalPivotAtr * signalAtrDistance and
     (not strictSignalNeedsRsi or formalPivotRsi >= 60)

bool formalBottomBase =
     not na(formalPivotLow) and
     not na(formalPivotCenter) and
     not na(formalPivotAtr) and
     formalPivotLow <= formalPivotCenter - formalPivotAtr * signalAtrDistance and
     (not strictSignalNeedsRsi or formalPivotRsi <= 40)

var int lastFormalTopBar = na
var float lastFormalTopPrice = na
var int lastFormalBottomBar = na
var float lastFormalBottomPrice = na

bool formalTopSpacingPassed = na(lastFormalTopBar) or formalPivotBar - lastFormalTopBar >= signalSpacing
bool formalBottomSpacingPassed = na(lastFormalBottomBar) or formalPivotBar - lastFormalBottomBar >= signalSpacing

bool formalTopOppositeSwingPassed =
     na(lastFormalBottomPrice) or
     (
         not na(formalPivotAtr) and
         math.abs(formalPivotHigh - lastFormalBottomPrice) >= formalPivotAtr * oppositeSwingAtr
     )

bool formalBottomOppositeSwingPassed =
     na(lastFormalTopPrice) or
     (
         not na(formalPivotAtr) and
         math.abs(formalPivotLow - lastFormalTopPrice) >= formalPivotAtr * oppositeSwingAtr
     )

bool formalTopEventRaw =
     formalTopBase and
     formalTopSpacingPassed and
     formalTopOppositeSwingPassed and
     barstate.isconfirmed

bool formalBottomEventRaw =
     formalBottomBase and
     formalBottomSpacingPassed and
     formalBottomOppositeSwingPassed and
     barstate.isconfirmed

bool turnConflict = formalTopEventRaw and formalBottomEventRaw
bool formalTopEvent = formalTopEventRaw and not formalBottomEventRaw
bool formalBottomEvent = formalBottomEventRaw and not formalTopEventRaw

if formalTopEvent
    lastFormalTopBar := formalPivotBar
    lastFormalTopPrice := formalPivotHigh
if formalBottomEvent
    lastFormalBottomBar := formalPivotBar
    lastFormalBottomPrice := formalPivotLow

plotchar(
     showObserveSignalsInput and quickTopEvent,
     title = "红色观察（实际确认K线）",
     char = "○",
     location = location.abovebar,
     color = color.rgb(245, 105, 105),
     size = size.tiny,
     display = display.all - display.status_line)

plotchar(
     showObserveSignalsInput and quickBottomEvent,
     title = "绿色观察（实际确认K线）",
     char = "○",
     location = location.belowbar,
     color = color.rgb(90, 200, 100),
     size = size.tiny,
     display = display.all - display.status_line)

plotshape(
     showTurnSignalsInput and formalTopEvent,
     title = "红色完整转折确认",
     style = shape.triangledown,
     location = location.abovebar,
     color = color.rgb(235, 65, 65),
     size = size.small,
     display = display.all - display.status_line)

plotshape(
     showTurnSignalsInput and formalBottomEvent,
     title = "绿色完整转折确认",
     style = shape.triangleup,
     location = location.belowbar,
     color = color.rgb(45, 175, 70),
     size = size.small,
     display = display.all - display.status_line)

plotshape(
     turnConflict,
     title = "转折冲突",
     style = shape.xcross,
     location = location.abovebar,
     color = color.orange,
     text = "冲突",
     textcolor = color.white,
     size = size.tiny,
     display = display.all - display.status_line)


//=============================================================================
// 方向证据：只跟随完整转折方向，不读取统一总分
//=============================================================================
bool bullEngulfing =
     close > open and
     close[1] < open[1] and
     open <= close[1] and
     close >= open[1]

bool bearEngulfing =
     close < open and
     close[1] > open[1] and
     open >= close[1] and
     close <= open[1]

string longCandleStructureRaw = ""
longCandleStructureRaw := f_addReason(longCandleStructureRaw, bullEngulfing, "看涨吞没")
longCandleStructureRaw := f_addReason(longCandleStructureRaw, longLowerWick, "下影确认")
longCandleStructureRaw := f_addReason(longCandleStructureRaw, sweepSupport, "假跌破收回")
longCandleStructureRaw := f_addReason(longCandleStructureRaw, bullSequence, "连续阳线")
longCandleStructureRaw := f_addReason(longCandleStructureRaw, reclaimKey, "收复EMA")

string shortCandleStructureRaw = ""
shortCandleStructureRaw := f_addReason(shortCandleStructureRaw, bearEngulfing, "看跌吞没")
shortCandleStructureRaw := f_addReason(shortCandleStructureRaw, shortUpperWick, "上影确认")
shortCandleStructureRaw := f_addReason(shortCandleStructureRaw, sweepResistance, "假突破跌回")
shortCandleStructureRaw := f_addReason(shortCandleStructureRaw, bearSequence, "连续阴线")
shortCandleStructureRaw := f_addReason(shortCandleStructureRaw, loseKey, "跌回EMA")

string longMomentumStateRaw = ""
longMomentumStateRaw := f_addReason(longMomentumStateRaw, bullRsiDiv or bullPpoDiv, "底背离")
longMomentumStateRaw := f_addReason(longMomentumStateRaw, bearMomentumWeak, "下跌动能减弱")
longMomentumStateRaw := f_addReason(longMomentumStateRaw, stochBullCross, "超卖区转强")
longMomentumStateRaw := f_addReason(longMomentumStateRaw, higherLow, "低点抬高")
longMomentumStateRaw := f_addReason(longMomentumStateRaw, volumeDownNoLow, "下跌承接增强")

string shortMomentumStateRaw = ""
shortMomentumStateRaw := f_addReason(shortMomentumStateRaw, bearRsiDiv or bearPpoDiv, "顶背离")
shortMomentumStateRaw := f_addReason(shortMomentumStateRaw, bullMomentumWeak, "上涨动能减弱")
shortMomentumStateRaw := f_addReason(shortMomentumStateRaw, stochBearCross, "超买区转弱")
shortMomentumStateRaw := f_addReason(shortMomentumStateRaw, lowerHigh, "高点降低")
shortMomentumStateRaw := f_addReason(shortMomentumStateRaw, volumeUpNoHigh, "上涨抛压增强")

string longStructureEvidenceRaw = ""
longStructureEvidenceRaw := f_addReason(longStructureEvidenceRaw, sweepSupport, "假跌破收回")
longStructureEvidenceRaw := f_addReason(longStructureEvidenceRaw, nearSupport, "接近支撑")
longStructureEvidenceRaw := f_addReason(longStructureEvidenceRaw, nearChannelLower, "通道下沿")
longStructureEvidenceRaw := f_addReason(longStructureEvidenceRaw, nearChannelMid and confirmedChannelSlope > 0 and reclaimKey, "上升通道中轨收复")

string shortStructureEvidenceRaw = ""
shortStructureEvidenceRaw := f_addReason(shortStructureEvidenceRaw, sweepResistance, "假突破跌回")
shortStructureEvidenceRaw := f_addReason(shortStructureEvidenceRaw, nearResistance, "接近压力")
shortStructureEvidenceRaw := f_addReason(shortStructureEvidenceRaw, nearChannelUpper, "通道上沿")
shortStructureEvidenceRaw := f_addReason(shortStructureEvidenceRaw, nearChannelMid and confirmedChannelSlope < 0 and loseKey, "下降通道中轨跌回")

//=============================================================================
// 市场环境与价值位置：直接布尔，不使用总分
//=============================================================================
bool costRising = not na(previousVwap) and currentValueCenter > previousVwap
bool costFalling = not na(previousVwap) and currentValueCenter < previousVwap
bool channelRising = channelReady and confirmedChannelSlope > 0
bool channelFalling = channelReady and confirmedChannelSlope < 0

bool environmentBullRaw = costRising and channelRising
bool environmentBearRaw = costFalling and channelFalling
bool environmentConflict = environmentBullRaw and environmentBearRaw
bool environmentBull = environmentBullRaw and not environmentConflict
bool environmentBear = environmentBearRaw and not environmentConflict

string environmentText =
     environmentBull ? "环境偏多" :
     environmentBear ? "环境偏空" :
     "震荡分歧"

bool outsideExpansion =
     (
         not na(currentUpper2) and
         not na(currentUpper2[1]) and
         close >= currentUpper2 and
         close[1] >= currentUpper2[1]
     )
     or
     (
         not na(currentLower2) and
         not na(currentLower2[1]) and
         close <= currentLower2 and
         close[1] <= currentLower2[1]
     )

string valuePositionText =
     outsideExpansion ? "价值区外扩张" :
     not na(currentLower2) and close <= currentLower2 ? "极端折价" :
     not na(currentUpper2) and close >= currentUpper2 ? "极端溢价" :
     not na(currentLower1) and close <= currentLower1 ? "合理折价" :
     not na(currentUpper1) and close >= currentUpper1 ? "合理溢价" :
     not na(currentValueCenter) ? "成本附近" :
     "数据不足"

string costDirectionText =
     na(previousVwap) ? "成本方向数据不足" :
     costRising ? "成本上移" :
     costFalling ? "成本下移" :
     "成本走平"

string channelDirectionText =
     not channelReady ? "通道数据不足" :
     channelRising ? "通道上行" :
     channelFalling ? "通道下行" :
     "通道走平"

string environmentSourceText = costDirectionText + "｜" + channelDirectionText

string valueSourceText =
     "现价 " + f_fmt(close) +
     "｜VWAP " + f_fmt(currentValueCenter) +
     "｜SD1 " + f_fmt(currentLower1) + " ~ " + f_fmt(currentUpper1)

//=============================================================================
// 计划检查与静态参考
//
// 回测诊断结论：
// - RR≥1.50硬门槛显著恶化历史表现；
// - 止损距离与RR只保留为透明提示，不再当作信号质量过滤器。
//=============================================================================
int PLAN_NONE = 0
int PLAN_DEFINED = 1
int PLAN_INSUFFICIENT = 2
int PLAN_CONFLICT = 3

f_floorTick(float value) =>
    na(value) ? na : math.floor(value / syminfo.mintick) * syminfo.mintick

f_ceilTick(float value) =>
    na(value) ? na : math.ceil(value / syminfo.mintick) * syminfo.mintick

f_fmtTime(int timestampValue) =>
    na(timestampValue) ? "—" : str.format_time(timestampValue, "MM-dd HH:mm", "Asia/Shanghai")

var int activePlanState = PLAN_NONE
var int activeSignalSide = 0
var int activeSignalBar = na
var int activeSignalTime = na
var float activeEntry = na
var float activeStop = na
var float activeTarget = na
var float activeRR = na
var float activeConfirmationAtr = na
var float activePivotPrice = na
var bool activePlanInvalidated = false
var string activePlanInvalidReason = "暂无"
var string activePlanCheck = "暂无"
var string frozenStructureEvidence = "暂无"
var string frozenMomentumEvidence = "暂无"
var string frozenCandleEvidence = "暂无"

var int lastObserveSide = 0
var int lastObserveBar = na

if quickBottomEvent
    lastObserveSide := 1
    lastObserveBar := bar_index
else if quickTopEvent
    lastObserveSide := -1
    lastObserveBar := bar_index

bool longStaticPlanGeneratedEvent = false
bool shortStaticPlanGeneratedEvent = false

if barstate.isconfirmed
    bool hasNewTurnOrConflict = turnConflict or formalBottomEvent or formalTopEvent

    if hasNewTurnOrConflict
        activePlanState := PLAN_NONE
        activeSignalSide := 0
        activeSignalBar := na
        activeSignalTime := na
        activeEntry := na
        activeStop := na
        activeTarget := na
        activeRR := na
        activeConfirmationAtr := na
        activePivotPrice := na
        activePlanInvalidated := false
        activePlanInvalidReason := "暂无"
        activePlanCheck := "暂无"
        frozenStructureEvidence := "暂无"
        frozenMomentumEvidence := "暂无"
        frozenCandleEvidence := "暂无"

    if turnConflict
        activePlanState := PLAN_CONFLICT
        activeSignalBar := bar_index
        activeSignalTime := time_close
        activePlanCheck := "同一根K线同时出现顶部与底部完整转折"

    else if formalBottomEvent or formalTopEvent
        bool isLongTurn = formalBottomEvent
        float referenceEntry = close
        float confirmationAtr = atr
        float structuralStopRaw = isLongTurn ? formalPivotLow - confirmationAtr * 0.15 : formalPivotHigh + confirmationAtr * 0.15
        float structuralStop = isLongTurn ? f_floorTick(structuralStopRaw) : f_ceilTick(structuralStopRaw)
        float minimumTargetDistance = confirmationAtr * 0.50

        float structuralTargetRaw = isLongTurn ?
             f_nearestAbove12(
                 referenceEntry,
                 minimumTargetDistance,
                 currentValueCenter,
                 previousVwap,
                 currentUpper1,
                 currentUpper2,
                 higherTrendVwap,
                 channelMid,
                 channelUpper,
                 priorHigh,
                 roundResistance,
                 resistance1,
                 resistance2,
                 resistance3) :
             f_nearestBelow12(
                 referenceEntry,
                 minimumTargetDistance,
                 currentValueCenter,
                 previousVwap,
                 currentLower1,
                 currentLower2,
                 higherTrendVwap,
                 channelMid,
                 channelLower,
                 priorLow,
                 roundSupport,
                 support1,
                 support2,
                 support3)

        float structuralTarget = isLongTurn ? f_floorTick(structuralTargetRaw) : f_ceilTick(structuralTargetRaw)
        float riskDistance = isLongTurn ? referenceEntry - structuralStop : structuralStop - referenceEntry
        float rewardDistance = isLongTurn ? structuralTarget - referenceEntry : referenceEntry - structuralTarget
        float rrValue = not na(riskDistance) and riskDistance > 0 and not na(rewardDistance) ? rewardDistance / riskDistance : na

        bool stopDataReady = not na(structuralStop)
        bool targetDataReady = not na(structuralTarget)
        bool directionReady =
             isLongTurn ?
                 stopDataReady and targetDataReady and structuralStop < referenceEntry and structuralTarget > referenceEntry :
                 stopDataReady and targetDataReady and structuralStop > referenceEntry and structuralTarget < referenceEntry

        bool stopTooClose = directionReady and riskDistance < confirmationAtr * 0.60
        bool stopTooFar = directionReady and riskDistance > confirmationAtr * 3.00
        bool rrTooLow = directionReady and not na(rrValue) and rrValue < rrLowWarningThreshold
        bool rrVeryHigh = directionReady and not na(rrValue) and rrValue > 8.00

        activeSignalSide := isLongTurn ? 1 : -1
        activeSignalBar := bar_index
        activeSignalTime := time_close
        activeEntry := referenceEntry
        activeStop := structuralStop
        activeTarget := structuralTarget
        activeRR := rrValue
        activeConfirmationAtr := confirmationAtr
        activePivotPrice := isLongTurn ? formalPivotLow : formalPivotHigh
        activePlanInvalidated := false
        activePlanInvalidReason := "暂无"

        frozenStructureEvidence :=
             isLongTurn ?
                 (longStructureEvidenceRaw == "" ? "无明确结构共振" : longStructureEvidenceRaw) :
                 (shortStructureEvidenceRaw == "" ? "无明确结构共振" : shortStructureEvidenceRaw)

        frozenMomentumEvidence :=
             isLongTurn ?
                 (longMomentumStateRaw == "" ? "无明显改善" : longMomentumStateRaw) :
                 (shortMomentumStateRaw == "" ? "无明显转弱" : shortMomentumStateRaw)

        frozenCandleEvidence :=
             isLongTurn ?
                 (longCandleStructureRaw == "" ? "无明确K线确认" : longCandleStructureRaw) :
                 (shortCandleStructureRaw == "" ? "无明确K线确认" : shortCandleStructureRaw)

        if na(referenceEntry) or na(confirmationAtr) or not stopDataReady or not targetDataReady or na(riskDistance) or riskDistance <= 0 or na(rrValue)
            activePlanState := PLAN_INSUFFICIENT
            activePlanCheck := not stopDataReady ? "结构止损数据不足" :
                 not targetDataReady ? "没有符合冻结规则的结构目标" :
                 "风险距离或RR数据不足"

        else if not directionReady
            activePlanState := PLAN_INSUFFICIENT
            activePlanCheck := "参考入场、止损或目标方向关系无效"

        else
            activePlanState := PLAN_DEFINED

            string warningText = ""
            warningText := f_addReason(warningText, stopTooClose, "止损过近")
            warningText := f_addReason(warningText, stopTooFar, "止损偏远")
            warningText := f_addReason(warningText, rrTooLow, "RR偏低")
            warningText := f_addReason(warningText, rrVeryHigh, "目标偏远")

            activePlanCheck :=
                 warningText == "" ?
                     "静态计划可定义｜未发现距离警告" :
                     "静态计划可定义｜" + warningText

            longStaticPlanGeneratedEvent := isLongTurn
            shortStaticPlanGeneratedEvent := not isLongTurn

    if not na(activeSignalBar) and bar_index - activeSignalBar >= showPlanExpiryBars and not hasNewTurnOrConflict
        activePlanState := PLAN_NONE
        activeSignalSide := 0
        activeSignalBar := na
        activeSignalTime := na
        activeEntry := na
        activeStop := na
        activeTarget := na
        activeRR := na
        activeConfirmationAtr := na
        activePivotPrice := na
        activePlanInvalidated := false
        activePlanInvalidReason := "暂无"
        activePlanCheck := "暂无"
        frozenStructureEvidence := "暂无"
        frozenMomentumEvidence := "暂无"
        frozenCandleEvidence := "暂无"

bool activeSnapshot = not na(activeSignalBar) and bar_index - activeSignalBar < showPlanExpiryBars

// 0.1.1只判断旧静态参考是否仍具当前参考意义，不记录盈亏或命中结果。
if barstate.isconfirmed and activeSnapshot and activePlanState == PLAN_DEFINED and not activePlanInvalidated and bar_index > activeSignalBar
    bool stopTouched =
         activeSignalSide == 1 ?
             low <= activeStop :
             activeSignalSide == -1 ?
                 high >= activeStop :
                 false

    bool targetTouched =
         activeSignalSide == 1 ?
             high >= activeTarget :
             activeSignalSide == -1 ?
                 low <= activeTarget :
                 false

    if stopTouched or targetTouched
        activePlanInvalidated := true
        activePlanInvalidReason :=
             stopTouched and targetTouched ? "价格区间已同时触及止损与目标，静态参考已失效" :
             stopTouched ? "价格已触及结构止损，静态参考已失效" :
             "价格已触及结构目标，静态参考已失效"

bool activePlanCurrentlyValid =
     activeSnapshot and
     activePlanState == PLAN_DEFINED and
     not activePlanInvalidated

bool staticPlanVisible = showStaticPlanLines and activePlanCurrentlyValid

plot(staticPlanVisible ? activeEntry : na, "静态计划参考入场", color = color.rgb(50, 180, 255), linewidth = 2, style = plot.style_linebr, display = display.all - display.status_line)
plot(staticPlanVisible ? activeStop : na, "静态计划结构止损", color = color.red, linewidth = 2, style = plot.style_linebr, display = display.all - display.status_line)
plot(staticPlanVisible ? activeTarget : na, "静态计划结构目标", color = color.rgb(180, 90, 255), linewidth = 2, style = plot.style_linebr, display = display.all - display.status_line)


//=============================================================================
// 手动结构位绘制
//=============================================================================
plot(showManualLevelsInput and useManualLevels and support1 > 0 ? support1 : na, "支撑1", color = color.new(color.lime, 30), linewidth = 1, style = plot.style_linebr, display = display.all - display.status_line)
plot(showManualLevelsInput and useManualLevels and support2 > 0 ? support2 : na, "支撑2", color = color.new(color.lime, 45), linewidth = 1, style = plot.style_linebr, display = display.all - display.status_line)
plot(showManualLevelsInput and useManualLevels and support3 > 0 ? support3 : na, "支撑3", color = color.new(color.lime, 60), linewidth = 1, style = plot.style_linebr, display = display.all - display.status_line)
plot(showManualLevelsInput and useManualLevels and resistance1 > 0 ? resistance1 : na, "压力1", color = color.new(color.red, 30), linewidth = 1, style = plot.style_linebr, display = display.all - display.status_line)
plot(showManualLevelsInput and useManualLevels and resistance2 > 0 ? resistance2 : na, "压力2", color = color.new(color.red, 45), linewidth = 1, style = plot.style_linebr, display = display.all - display.status_line)
plot(showManualLevelsInput and useManualLevels and resistance3 > 0 ? resistance3 : na, "压力3", color = color.new(color.red, 60), linewidth = 1, style = plot.style_linebr, display = display.all - display.status_line)

//=============================================================================
// 08. 线名与面板
//=============================================================================
showLineLabels = input.bool(true, "显示线名", group = GRP_DISPLAY)
tablePositionInput = input.string("右上", "面板位置", options = ["右上", "右下", "左上", "左下"], group = GRP_DISPLAY)

int lineLabelBaseOffset = 8
var label currentCenterLabel = na
var label higherVwapLabel = na
var label upper1Label = na
var label lower1Label = na
var label upper2Label = na
var label lower2Label = na
var label pVwapLabel = na
var label pUpper1Label = na
var label pLower1Label = na

upper2Label := f_updateRightLabel(upper2Label, currentUpper2, "—— " + currentPeriodText + "SD+2", sd2UpColor, showLineLabels and showSd2, lineLabelBaseOffset)
upper1Label := f_updateRightLabel(upper1Label, currentUpper1, "—— " + currentPeriodText + "SD+1", sd1Color, showLineLabels and showSd1, lineLabelBaseOffset + 2)
currentCenterLabel := f_updateRightLabel(currentCenterLabel, currentValueCenter, "—— " + currentPeriodText + "VWAP（当前成本）", currentVwapColor, showLineLabels and showCurrentCenter, lineLabelBaseOffset + 4)
lower1Label := f_updateRightLabel(lower1Label, currentLower1, "—— " + currentPeriodText + "SD-1", sd1Color, showLineLabels and showSd1, lineLabelBaseOffset + 6)
lower2Label := f_updateRightLabel(lower2Label, currentLower2, "—— " + currentPeriodText + "SD-2", sd2DownColor, showLineLabels and showSd2, lineLabelBaseOffset + 8)

pUpper1Label := f_updateRightLabel(pUpper1Label, previousUpper1, "··· " + previousPeriodText + "pSD+1", pSdColor, showLineLabels and showPsd1, lineLabelBaseOffset + 16)
pVwapLabel := f_updateRightLabel(pVwapLabel, previousVwap, "- - " + previousPeriodText + "pVWAP", pVwapColor, showLineLabels and showPvw, lineLabelBaseOffset + 19)
pLower1Label := f_updateRightLabel(pLower1Label, previousLower1, "··· " + previousPeriodText + "pSD-1", pSdColor, showLineLabels and showPsd1, lineLabelBaseOffset + 22)
higherVwapLabel := f_updateRightLabel(higherVwapLabel, higherTrendVwap, "━━ " + higherTrendName, higherVwapColor, showLineLabels and showHigherVwap, lineLabelBaseOffset + 32)

bool testedExchange = syminfo.prefix == "BINANCE"
bool testedPair =
     syminfo.ticker == "BTCUSDT" or
     syminfo.ticker == "ETHUSDT" or
     syminfo.ticker == "SOLUSDT"

bool testedSymbol = testedExchange and testedPair

float chartSeconds = timeframe.in_seconds(timeframe.period)
bool testedTimeframe = chartSeconds == 3600 or chartSeconds == 14400
bool engineeringTested = testedSymbol and testedTimeframe

string engineeringText = engineeringTested ? "已列入0.1.4基础工程测试" : "未完成本版本工程测试"
string observeText =
     not na(lastObserveBar) and bar_index - lastObserveBar <= 8 ?
         (lastObserveSide == 1 ? "绿色观察" : "红色观察") :
         "暂无"

string turnText =
     activePlanState == PLAN_CONFLICT ? "转折冲突" :
     activeSnapshot and activeSignalSide == 1 ? "绿色完整转折确认" :
     activeSnapshot and activeSignalSide == -1 ? "红色完整转折确认" :
     "暂无"

string planCheckText =
     activePlanState == PLAN_DEFINED and activePlanInvalidated ? "信号当时可定义｜当前已失效" :
     activePlanState == PLAN_DEFINED ? activePlanCheck :
     activePlanState == PLAN_INSUFFICIENT ? "数据不足｜" + activePlanCheck :
     activePlanState == PLAN_CONFLICT ? "转折冲突" :
     "无当前计划检查"

string confirmationTimeText = f_fmtTime(activeSignalTime)

string planText =
     activePlanState == PLAN_DEFINED and activeSnapshot and activePlanInvalidated ?
         "静态参考已失效｜确认 " + confirmationTimeText + "｜" + activePlanInvalidReason :
     activePlanState == PLAN_DEFINED and activeSnapshot ?
         (activeSignalSide == 1 ? "多头参考" : "空头参考") +
         "｜确认 " + confirmationTimeText +
         "｜入场 " + f_fmt(activeEntry) +
         "｜止损 " + f_fmt(activeStop) +
         "｜目标 " + f_fmt(activeTarget) +
         "｜RR " + f_fmtRR(activeRR) :
     activePlanState == PLAN_INSUFFICIENT ?
         "未生成静态计划｜确认 " + confirmationTimeText :
     "暂无静态计划"

string stopBasisText =
     activeSignalSide == 1 ?
         "正式底部枢轴 " + f_fmt(activePivotPrice) + " - 0.15×确认ATR " + f_fmt(activeConfirmationAtr) :
     activeSignalSide == -1 ?
         "正式顶部枢轴 " + f_fmt(activePivotPrice) + " + 0.15×确认ATR " + f_fmt(activeConfirmationAtr) :
     "暂无"

string currentAdvice =
     activePlanState == PLAN_CONFLICT ? "转折冲突，等待下一次信号" :
     activePlanState == PLAN_DEFINED and activePlanInvalidated ? "静态参考已失效，等待下一次转折" :
     activePlanState == PLAN_DEFINED ? "静态计划可定义｜请结合环境与仓位判断" :
     activePlanState == PLAN_INSUFFICIENT ? "静态计划数据不足" :
     quickBottomEvent or quickTopEvent ? "观察阶段，不提前入场" :
     formalBottomEvent or formalTopEvent ? "枢轴转折已确认" :
     "无信号，等待"

string tablePosition =
     tablePositionInput == "右下" ? position.bottom_right :
     tablePositionInput == "左上" ? position.top_left :
     tablePositionInput == "左下" ? position.bottom_left :
     position.top_right

var table dashboard = table.new(tablePosition, 2, 22, border_width = 1)

bool renderDashboard = barstate.islast or barstate.islastconfirmedhistory
if renderDashboard
    table.clear(dashboard, 0, 0, 1, 21)

    table.cell(dashboard, 0, 0, "Logic Stack Entry 2.0", text_color = color.white, bgcolor = color.rgb(32, 45, 64))
    table.cell(dashboard, 1, 0, "Public Preview 0.1.4", text_color = color.aqua, bgcolor = color.rgb(32, 45, 64))

    table.cell(dashboard, 0, 1, "工程范围", text_color = color.silver)
    table.cell(dashboard, 1, 1, engineeringText, text_color = engineeringTested ? color.lime : color.orange)

    table.cell(dashboard, 0, 2, "市场环境", text_color = color.silver)
    table.cell(dashboard, 1, 2, environmentText, text_color = environmentBull ? color.lime : environmentBear ? color.red : color.orange)

    table.cell(dashboard, 0, 3, "成本方向", text_color = color.silver)
    table.cell(dashboard, 1, 3, costDirectionText, text_color = color.aqua)

    table.cell(dashboard, 0, 4, "价值位置", text_color = color.silver)
    table.cell(dashboard, 1, 4, valuePositionText, text_color = color.white)

    table.cell(dashboard, 0, 5, "最近观察", text_color = color.silver)
    table.cell(dashboard, 1, 5, observeText, text_color = lastObserveSide == 1 ? color.lime : lastObserveSide == -1 ? color.red : color.silver)

    table.cell(dashboard, 0, 6, "最近完整转折", text_color = color.silver)
    table.cell(dashboard, 1, 6, turnText, text_color = activeSignalSide == 1 ? color.lime : activeSignalSide == -1 ? color.red : activePlanState == PLAN_CONFLICT ? color.orange : color.silver)

    table.cell(dashboard, 0, 7, "结构证据", text_color = color.silver)
    table.cell(dashboard, 1, 7, frozenStructureEvidence, text_color = color.white)

    table.cell(dashboard, 0, 8, "动能证据", text_color = color.silver)
    table.cell(dashboard, 1, 8, frozenMomentumEvidence, text_color = color.white)

    table.cell(dashboard, 0, 9, "K线证据", text_color = color.silver)
    table.cell(dashboard, 1, 9, frozenCandleEvidence, text_color = color.white)

    table.cell(dashboard, 0, 10, "计划检查", text_color = color.silver)
    table.cell(
         dashboard,
         1,
         10,
         planCheckText,
         text_color =
             activePlanState == PLAN_DEFINED and activePlanCheck == "静态计划可定义｜未发现距离警告" ?
                 color.lime :
             activePlanState == PLAN_DEFINED ?
                 color.orange :
             activePlanState == PLAN_CONFLICT ?
                 color.orange :
                 color.silver)

    table.cell(dashboard, 0, 11, "静态计划", text_color = color.silver)
    table.cell(dashboard, 1, 11, planText, text_color = color.rgb(190, 120, 255))

    table.cell(dashboard, 0, 12, "当前建议", text_color = color.silver)
    table.cell(dashboard, 1, 12, currentAdvice, text_color = color.aqua)

    table.cell(dashboard, 0, 13, "免责声明", text_color = color.silver)
    table.cell(dashboard, 1, 13, "辅助工具｜计划提示不代表信号准确率", text_color = color.yellow)

    if panelDisplayMode == "详细"
        table.cell(dashboard, 0, 14, "确认时间", text_color = color.silver)
        table.cell(dashboard, 1, 14, confirmationTimeText, text_color = color.aqua)

        table.cell(dashboard, 0, 15, "环境来源", text_color = color.silver)
        table.cell(dashboard, 1, 15, environmentSourceText, text_color = color.white)

        table.cell(dashboard, 0, 16, "价值位置来源", text_color = color.silver)
        table.cell(dashboard, 1, 16, valueSourceText, text_color = color.white)

        table.cell(dashboard, 0, 17, "止损依据", text_color = color.silver)
        table.cell(dashboard, 1, 17, stopBasisText, text_color = color.white)

        table.cell(dashboard, 0, 18, "风险原因", text_color = color.silver)
        table.cell(dashboard, 1, 18, activePlanInvalidated ? activePlanInvalidReason : activePlanCheck, text_color = color.orange)

        table.cell(dashboard, 0, 19, "参考入场 / 止损", text_color = color.silver)
        table.cell(dashboard, 1, 19, f_fmt(activeEntry) + " / " + f_fmt(activeStop), text_color = color.white)

        table.cell(dashboard, 0, 20, "结构目标 / RR", text_color = color.silver)
        table.cell(dashboard, 1, 20, f_fmt(activeTarget) + " / " + f_fmtRR(activeRR), text_color = color.rgb(190, 120, 255))

        table.cell(dashboard, 0, 21, "规格", text_color = color.silver)
        table.cell(dashboard, 1, 21, PUBLIC_SPEC, text_color = color.aqua)

    for rowIndex = 0 to 21
        for columnIndex = 0 to 1
            table.cell_set_text_size(dashboard, columnIndex, rowIndex, size.small)

//=============================================================================
// 09. 六组收盘确认警报
//=============================================================================
alertcondition(quickBottomEvent and barstate.isconfirmed, "[收盘确认] 绿色观察", "Logic Stack Entry 2.0 Public Preview 0.1.4：绿色早期观察成立，尚未形成完整枢轴确认")
alertcondition(quickTopEvent and barstate.isconfirmed, "[收盘确认] 红色观察", "Logic Stack Entry 2.0 Public Preview 0.1.4：红色早期观察成立，尚未形成完整枢轴确认")
alertcondition(formalBottomEvent and barstate.isconfirmed, "[收盘确认] 绿色完整转折确认", "Logic Stack Entry 2.0 Public Preview 0.1.4：底部枢轴转折结构已经确认，不代表必然反转")
alertcondition(formalTopEvent and barstate.isconfirmed, "[收盘确认] 红色完整转折确认", "Logic Stack Entry 2.0 Public Preview 0.1.4：顶部枢轴转折结构已经确认，不代表必然反转")
alertcondition(
     longStaticPlanGeneratedEvent and barstate.isconfirmed,
     "[收盘确认] 多头静态计划已生成",
     "Logic Stack Entry 2.0 Public Preview 0.1.4：已生成多头参考入场、结构止损、结构目标和RR；只作计划展示，不代表信号更准确")

alertcondition(
     shortStaticPlanGeneratedEvent and barstate.isconfirmed,
     "[收盘确认] 空头静态计划已生成",
     "Logic Stack Entry 2.0 Public Preview 0.1.4：已生成空头参考入场、结构止损、结构目标和RR；只作计划展示，不代表信号更准确")

